# Verbito affiliate portal.
affiliate.verbito.ai {
	encode zstd gzip
	root * /srv/verbito

	handle /robots.txt {
		rewrite * /affiliate-robots.txt
		file_server
	}

	# Same release root as verbito.ai: the Atlas files (and its gated /atlas/full/
	# data) are served only on atlas.verbito.ai.
	@atlasFiles path /atlas /atlas/*
	handle @atlasFiles {
		respond 404
	}

	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		header Cache-Control "no-cache"
		try_files {path} /affiliate.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		X-Frame-Options "DENY"
		X-Robots-Tag "noindex, nofollow"
	}
}

# Managed by verbito.ai scripts/deploy/deploy-vps.sh — keep in sync; do not edit here.

# Verbito Open Source AI Atlas.
atlas.verbito.ai {
	encode zstd gzip
	root * /srv/verbito/atlas

	# The paid Atlas: only for entitled accounts (supabase/functions/atlas-gate).
	handle /full/* {
		forward_auth supabase-kong:8000 {
			uri /functions/v1/atlas-gate
			header_up apikey "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6InN1cGFiYXNlIiwiaWF0IjoxNzgyOTAzMDgxLCJleHAiOjIwOTgyNjMwODF9.APsBU8Wv3vSYfuagwT7R-7oZWw6crpBIaGvs2mwUIyQ"
			header_up Authorization "Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6InN1cGFiYXNlIiwiaWF0IjoxNzgyOTAzMDgxLCJleHAiOjIwOTgyNjMwODF9.APsBU8Wv3vSYfuagwT7R-7oZWw6crpBIaGvs2mwUIyQ"
		}
		@fullHashed path_regexp \.[0-9a-f]{10}\.[a-z]+$
		header @fullHashed ?Cache-Control "private, max-age=31536000, immutable"
		@fullOther not path_regexp \.[0-9a-f]{10}\.[a-z]+$
		header @fullOther ?Cache-Control "private, no-cache"
		header X-Robots-Tag "noindex, nofollow"
		file_server
	}

	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle /data/* {
		@dataHashed path_regexp \.[0-9a-f]{10}\.json$
		header @dataHashed Cache-Control "public, max-age=31536000, immutable"
		@dataOther not path_regexp \.[0-9a-f]{10}\.json$
		header @dataOther Cache-Control "public, max-age=3600"
		file_server
	}

	handle {
		header Cache-Control "no-cache"
		try_files {path} {path}.html {path}/index.html =404
		file_server
	}

	# Unknown paths: status 404 with the prerendered page (Arabic under /ar).
	handle_errors 404 {
		header Cache-Control "no-cache"
		@arabic path /ar /ar/*
		rewrite @arabic /ar/404.html
		rewrite * /404.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
	}
}
# End of Verbito Open Source AI Atlas.
