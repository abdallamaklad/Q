# Caddy auto-provisions and renews TLS certificates from Let's Encrypt for the
# domain set in $DOMAIN, and reverse-proxies to the Next.js web container.
#
# This Caddy is shared by every site on this VPS. The blocks below for
# verbito.ai, atlas.verbito.ai, doyouknow.app, supabase.verbito.ai and
# affiliate.verbito.ai belong to those products, whose own deploy scripts keep
# them current by finding each block's own marker comment line. They are
# committed here as well because this repo's deploy runs `git reset --hard`,
# which used to drop them until each product deployed again. One block per
# domain. Never quote a marker line in a comment: a deploy script would match it
# and insert a duplicate block. The deploy workflow refuses to deploy a Caddyfile
# that fails `caddy validate` or lacks the www.verbito.ai / atlas.verbito.ai blocks.
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip
	reverse_proxy web:3002

	# Long-lived caching for Next static assets.
	@static path /_next/static/* /icon.svg
	header @static Cache-Control "public, max-age=31536000, immutable"

	header {
		# Sensible security headers.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
	}
}

# Managed by verbito.ai scripts/deploy/deploy-vps.sh — keep in sync; do not edit here.

# Verbito static app.
verbito.ai {
	encode zstd gzip
	root * /srv/verbito

	# SEO routing (organic tech audit 2026-11-05, item 1). Every redirect keeps
	# the query string ({?query}): UTM and fbclid on paid traffic depend on it.
	# Redirect targets are absolute so a path such as //example.com/ can never
	# turn into a protocol-relative open redirect.

	# Trailing slash: 308 to the canonical no-slash URL. "/" itself is untouched.
	@trailingSlash path_regexp trailingSlash ^(/.*?)/+$
	redir @trailingSlash https://verbito.ai{re.trailingSlash.1}{?query} 308

	# Old URLs that the app only redirected client-side.
	redir /course https://verbito.ai/courses{?query} 308
	redir /compare https://verbito.ai/compare/best-free-ai-prompt-generators{?query} 308
	redir /refund https://verbito.ai/refund-policy{?query} 308

	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	@staticAssets path *.jpg *.jpeg *.png *.webp *.svg *.ico *.woff *.woff2
	handle @staticAssets {
		header Cache-Control "public, max-age=604800"
		file_server
	}

	# Build artifacts that are not pages on this host: a real 404.
	# /atlas is dist/atlas, served only on atlas.verbito.ai (its /atlas/full/ data is gated there).
	@notPages path /404 /404.html /affiliate /affiliate.html /affiliate-robots.txt /atlas /atlas/*
	handle @notPages {
		error 404
	}

	# Client-only app routes (src/App.tsx). They get their prerendered noindex
	# shell when one exists, else the app shell. Every other path must be a real
	# file or prerendered page, or it is a 404. The build (scripts/prerender.mjs)
	# and tests/routing.test.mjs fail if an App.tsx route is neither prerendered,
	# listed here, nor redirected above.
	@spaRoutes path /dashboard /account /admin /billing /collections /saved-prompts /welcome /login /signup /forgot-password /reset-password /pro /checkout /checkout/complete /checkout/guest /checkout/guest/complete /course/dashboard /course/certificate /course/lesson/* /course/ai-image-generation-mastery/dashboard /course/ai-image-generation-mastery/certificate /course/ai-image-generation-mastery/lesson/* /prompt-kit/pack /p/*
	handle @spaRoutes {
		header Cache-Control "no-cache"
		try_files {path}.html /index.html
		file_server
	}

	handle {
		header Cache-Control "no-cache"
		# {path}/index.html serves "/" (dist/index.html is the only directory index).
		try_files {path} {path}.html {path}/index.html =404
		file_server
	}

	# Unknown paths: status 404 with the prerendered noindex page.
	handle_errors 404 {
		header Cache-Control "no-cache"
		rewrite * /404.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
	}
}

www.verbito.ai {
	redir https://verbito.ai{uri} 308
}
# End of Verbito static app.

# Quantara marketing site — static files served from /var/www/html on the host
# (bind-mounted into this container as /srv/wearequantara; see docker-compose.prod.yml).
wearequantara.com, www.wearequantara.com {
	encode zstd gzip
	root * /srv/wearequantara
	file_server

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
	}
}

# doyouknow.app static bilingual editorial site.
doyouknow.app, www.doyouknow.app {
	encode zstd gzip
	root * /srv/doyouknow

	@mutable-assets path /assets/css/style.css /assets/js/site.js /assets/js/search-index.en.json /assets/js/search-index.ar.json
	header @mutable-assets Cache-Control "public, max-age=300, must-revalidate"

	@immutable {
		path /assets/*
		not path /assets/css/style.css /assets/js/site.js /assets/js/search-index.en.json /assets/js/search-index.ar.json
	}
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	@html path *.html / /en/* /ar/*
	header @html Cache-Control "public, max-age=300, must-revalidate"

	try_files {path} {path}/index.html
	file_server

	# Serve the language-appropriate custom 404 page (missing URLs
	# previously returned an empty 404 body).
	handle_errors {
		@notfound expression {err.status_code} == 404
		handle @notfound {
			@ar path /ar/*
			handle @ar {
				rewrite * /ar/404.html
				file_server
			}
			handle {
				rewrite * /en/404.html
				file_server
			}
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://www.google-analytics.com https://www.googletagmanager.com; connect-src 'self' https://www.google-analytics.com https://analytics.google.com https://www.googletagmanager.com https://buttondown.com; font-src 'self'; manifest-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}
}

# Managed by verbito.ai scripts/deploy/deploy-vps.sh — keep in sync; do not edit here.

# Verbito Supabase (self-hosted).
supabase.verbito.ai {
